# ==============================================================================
# SCANNAI - Comprehensive .gitignore
# Product: SCANNAI | Team: ROCKERZ
# ==============================================================================

# --- Critical Security & Environment Secrets ---
# Never commit credentials, API tokens, private keys, or environment files
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
secrets/
credentials/

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (Local backend isolation)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Node.js & Frontend Artifacts ---
node_modules/
frontend/node_modules/
.pnp
.pnp.js
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Runtime Uploads & Case Evidence (Data Privacy Protection) ---
# Never persist or commit user evidence, uploaded files, or generated audit dossiers
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/reports/*
!backend/storage/reports/.gitkeep
backend/storage/temp/*
!backend/storage/temp/.gitkeep

# --- OS & Editor Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project
