# ==============================================================================
# SCANNAI - Backend Environment Configuration Template
# COPY this file to .env before starting the backend:
#   copy .env.example .env
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
APP_NAME="SCANNAI Core Forensic Engine"
APP_VERSION="0.1.0"
DEBUG=true

# Server Network Binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & Upload Ingestion Controls
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MIME_TYPES=["application/pdf", "image/png", "image/jpeg", "image/webp"]
STORAGE_PATH="backend/storage"

# Google AI (Gemini) Configuration (Free Tier via Google AI Studio)
# In Phase 2, this is not activated. In Phase 4, supply your key from https://aistudio.google.com/
# NEVER hardcode or commit your real API key!
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
